# Bloquea cualquier acceso web directo a esta carpeta.
# Guarda los archivos que quedaron a la espera de que el usuario confirme una importación
# duplicada: son datos de pedidos y no tienen por qué poder descargarse por URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
