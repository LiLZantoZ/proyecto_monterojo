# Esta carpeta contiene scripts de mantenimiento pensados para ejecutarse por línea de
# comandos (cron/Task Scheduler), nunca por navegador. Bloquea cualquier acceso web directo.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
