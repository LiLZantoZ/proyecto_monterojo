APP_NAME="Sistema Monterojo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/monterojo_laravel
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La base de datos. Durante la migración apunta a una COPIA (monterojo_laravel) para no tocar la
# del sistema en producción (proyecto_monterojo). Al pasar a producción se cambia solo esta línea.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monterojo_laravel
DB_USERNAME=root
DB_PASSWORD=

# Sesiones y caché en archivos: así Laravel no necesita tablas propias en la base del sistema.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Minutos sin actividad antes de cerrar la sesión (el sistema actual usa 10).
MONTEROJO_INACTIVIDAD_MINUTOS=10

# Rótulos e impresión remota (mismos valores por defecto que config/config.php del sistema actual).
URL_PUBLICA_ROTULOS=
IMPRESORA_ROTULOS="TSC TA210"
IMPRESION_ROTULOS_MODO=remota
# TOKEN_AGENTE_IMPRESION=   (el mismo que tenga configurado el agente de la otra PC)

MAIL_MAILER=log

