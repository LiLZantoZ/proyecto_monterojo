# Evita que se pueda listar el contenido de una carpeta si no hay index
Options -Indexes

# Bloquea el acceso directo a archivos de configuración/control de versiones
<FilesMatch "^(composer\.json|composer\.lock|\.env|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquea el acceso al directorio .git/ completo (el FilesMatch de arriba solo compara el nombre de archivo, no la ruta)
RewriteEngine On
RewriteRule "(^|/)\.git/" - [F,L]

