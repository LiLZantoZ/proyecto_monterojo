# Todo lo que se pide a la carpeta del proyecto se atiende desde public/, que es la única carpeta
# pública de Laravel. Así el sistema se abre en http://localhost/monterojo_laravel/ sin tocar la
# configuración de Apache, y .env, app/, vendor/, storage/ quedan fuera del alcance del navegador.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
