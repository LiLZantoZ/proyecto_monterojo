# Bloquea la ejecución de scripts subidos accidentalmente a esta carpeta de imágenes
<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
